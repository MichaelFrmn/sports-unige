{
  "expo": {
    "name": "Sports UNIGE",
    "slug": "sports-unige",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mikefreeman.sportsunige"
    },
    "android": {
      "package": "com.mikefreeman.sportsunige",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F20066"
      },
      "permissions": []
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "edf1ae21-305e-44d1-a9c6-5ba2e1bc1486"
      }
    },
    "owner": "michael.frmn"
  }
}
